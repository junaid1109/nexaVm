{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "sync-data": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-data.ps1",
    "dev": "npm run sync-data && cross-env NODE_OPTIONS=\"--no-deprecation\" nuxt dev",
    "build": "npm run sync-data && cross-env NODE_OPTIONS=\"--no-deprecation\" nuxt build",
    "generate": "npm run sync-data && cross-env NODE_OPTIONS=\"--no-deprecation\" nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify/utils": "^3.1.0",
    "@nuxt/content": "3.6.3",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "2.0.0",
    "@nuxt/image": "1.11.0",
    "@nuxtjs/i18n": "10.1.0",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "better-sqlite3": "^12.2.0",
    "eslint": "^9.35.0",
    "nuxt": "^4.1.0",
    "reka-ui": "2.5.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "yup": "^1.7.1"
  },
  "packageManager": "pnpm@10.16.0",
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^10.1.0",
    "nodemailer": "^7.0.6",
    "nuxt-nodemailer": "^1.1.2",
    "ohash": "^2.0.11"
  }
}
